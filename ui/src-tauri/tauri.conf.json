{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AsySounds",
  "version": "0.1.3",
  "identifier": "com.asygames.asysounds",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AsySounds",
        "width": 1160,
        "height": 760,
        "minWidth": 850,
        "minHeight": 560,
        "backgroundColor": "#10121b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data: blob:; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": null
    }
  }
}